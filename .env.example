# ==============================================================================
# Microsoft Purview Managed Service Executive Reporting Portal — Environment
# ==============================================================================

# Application mode
NODE_ENV=development
PORT=4010
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4010

# Data provider: "demo" (14-month deterministic synthetic multi-tenant data) or "postgres"
DATA_PROVIDER=demo

# PostgreSQL connection string (used when DATA_PROVIDER=postgres)
DATABASE_URL=postgresql://purview_app:change-me-in-production@localhost:5432/purview_reporting

# Authentication mode: "demo" (persona switcher + signed demo header) or "entra" (Microsoft Entra ID OIDC JWT)
AUTH_MODE=demo

# Microsoft Entra ID OIDC (required when AUTH_MODE=entra)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://purview-executive-reporting

# Microsoft Graph & Office 365 Management API (app-only collector credentials)
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=
GRAPH_CERT_THUMBPRINT=
ENABLE_BETA_CONNECTORS=false

# Secret provider: "env" (local) or "azure-keyvault" (production)
SECRET_PROVIDER=env
AZURE_KEY_VAULT_URI=

# Optional PowerShell Security & Compliance snapshot path
POWERSHELL_SNAPSHOT_DIR=./collectors/powershell/output

# Optional Microsoft Sentinel Log Analytics Workspace ID
SENTINEL_WORKSPACE_ID=

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180
